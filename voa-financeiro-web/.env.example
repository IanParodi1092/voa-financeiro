# ---------------------------------------------------------------------------
# VOA Financeiro - exemplo de ambiente
# Copie para `.env` na raiz do monorepo (`voa-financeiro-web/.env`) e ajuste.
# O `.env` nunca vai para o controle de versao (ver `.gitignore`).
# O schema que valida estas variaveis esta em `apps/api/src/config.ts`: o que
# nao estiver la e simplesmente ignorado, e o que for obrigatorio derruba a
# subida da API com a mensagem do zod.
# ---------------------------------------------------------------------------

# --- aplicacao -------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_MAX=100

# --- banco canonico (OBRIGATORIO) ------------------------------------------
# Alvo atual do projeto: PostgreSQL local. A API, as migrations e os scripts
# de carga leem sempre DATABASE_URL/DIRECT_DATABASE_URL; nao existe flag para
# trocar de banco em tempo de execucao.
# Container de referencia: porta 5434, banco `voa_staging` (ver docs/LOCAL_DEVELOPMENT.md).
DATABASE_URL=postgresql://postgres:SENHA@localhost:5434/voa_staging
# Opcional: usado por ferramentas que precisam de conexao direta (sem pooler).
# Quando ausente, os scripts caem para DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:SENHA@localhost:5434/voa_staging

# --- autenticacao (OBRIGATORIO: minimo 32 caracteres) ----------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# Opcional: chave separada para o refresh token. Sem ela, usa AUTH_JWT_SECRET.
AUTH_REFRESH_SECRET=
COOKIE_DOMAIN=
# true/1/yes/on em producao (HTTPS). Em localhost, false.
COOKIE_SECURE=false

# --- migracao do legado ----------------------------------------------------
# Staging das abas do workbook: lido pelos scripts Python (`stage_legacy_workbook.py`,
# `load_canonical_batch.py`, `backfill_legacy_provenance.py`) e principal destino de
# leitura da validacao. Ausente, os scripts caem para DATABASE_URL.
STAGING_DATABASE_URL=postgresql://postgres:SENHA@localhost:5434/voa_staging
# Reservados no schema (`apps/api/src/config.ts`); nenhum script os le hoje.
# MIGRATION_SOURCE_DIR=../../_import
# MIGRATION_BATCH_SIZE=500

# --- integracoes ----------------------------------------------------------
# ASAAS_ENVIRONMENT e ASAAS_WEBHOOK_TOKEN sao lidos pela rota de webhook;
# sem o token, o webhook responde 401. Asaas/ChatGuru/SMTP nao tem cliente
# implementado ainda.
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=
# WEBHOOK_RETRY_LIMIT=5
# Cliente do Asaas usado pelo worker da fila (`docs/OUTBOX_DESIGN.md`).
# Sem ASAAS_API_KEY a API sobe, o worker fica idle e as linhas continuam
# `pending` (visiveis em `GET /api/v1/ops/outbox`).
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=

# --- fila de saida (outbox) ----------------------------------------------
# Desligar o worker nao desliga o enfileiramento: so para de enviar.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=5
OUTBOX_MAX_ATTEMPTS=8
# Sem heartbeat por 5 min, o reaper devolve a linha para `pending`.
OUTBOX_LEASE_TIMEOUT_MS=300000

# --- testes de integracao --------------------------------------------------
# Banco descartavel: as migrations rodam em um schema temporario e o banco
# escolhido nao e alterado. Sem esta variavel, o bloco de integracao e pulado.
# TEST_DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/voa_api_test
